-- Room-Based Socket Communication System
local Socket = loadstring(game:HttpGet("https://socket.bug.tools/"))()
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local RoomSystem = {}
RoomSystem.CurrentRoom = nil
RoomSystem.RoomChannel = nil
RoomSystem.IsHost = false

-- Generate random alphanumeric room ID
local function generateRoomID()
	local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
	local id = ""
	for i = 1, 6 do
		local rand = math.random(1, #chars)
		id = id .. chars:sub(rand, rand)
	end
	return id
end

-- Hash room ID to channel number
local function hashRoomID(roomID)
	local hash = 0
	for i = 1, #roomID do
		hash = (bit32.lshift(hash, 5) + hash) + roomID:byte(i)
		hash = bit32.band(hash, 4294967295)
	end
	return hash
end

-- Create a new room
function RoomSystem.Create()
	if RoomSystem.CurrentRoom then
		return false, "Already in a room. Leave first."
	end
	
	local roomID = generateRoomID()
	local channelHash = hashRoomID(roomID)
	
	RoomSystem.CurrentRoom = roomID
	RoomSystem.RoomChannel = Socket.Connect("ROOM_" .. roomID, channelHash)
	RoomSystem.IsHost = true
	
	-- Listen for messages
	RoomSystem.RoomChannel.OnMessage:Connect(function(player, msgType, data)
		if msgType == "JOIN" then
			if RoomSystem.OnPlayerJoined then
				RoomSystem.OnPlayerJoined(player, data)
			end
		elseif msgType == "LEAVE" then
			if RoomSystem.OnPlayerLeft then
				RoomSystem.OnPlayerLeft(player, data)
			end
		elseif msgType == "MESSAGE" then
			if RoomSystem.OnMessage then
				RoomSystem.OnMessage(player, data)
			end
		end
	end)
	
	-- Announce presence
	RoomSystem.RoomChannel:Send("JOIN", LocalPlayer.DisplayName)
	
	return true, roomID
end

-- Join an existing room
function RoomSystem.Join(roomID)
	if RoomSystem.CurrentRoom then
		return false, "Already in a room. Leave first."
	end
	
	if not roomID or #roomID ~= 6 then
		return false, "Invalid room ID. Must be 6 characters."
	end
	
	roomID = roomID:upper()
	local channelHash = hashRoomID(roomID)
	
	RoomSystem.CurrentRoom = roomID
	RoomSystem.RoomChannel = Socket.Connect("ROOM_" .. roomID, channelHash)
	RoomSystem.IsHost = false
	
	-- Listen for messages
	RoomSystem.RoomChannel.OnMessage:Connect(function(player, msgType, data)
		if msgType == "JOIN" then
			if RoomSystem.OnPlayerJoined then
				RoomSystem.OnPlayerJoined(player, data)
			end
		elseif msgType == "LEAVE" then
			if RoomSystem.OnPlayerLeft then
				RoomSystem.OnPlayerLeft(player, data)
			end
		elseif msgType == "MESSAGE" then
			if RoomSystem.OnMessage then
				RoomSystem.OnMessage(player, data)
			end
		end
	end)
	
	-- Announce presence
	RoomSystem.RoomChannel:Send("JOIN", LocalPlayer.DisplayName)
	
	return true, "Joined room: " .. roomID
end

-- Leave current room
function RoomSystem.Leave()
	if not RoomSystem.CurrentRoom then
		return false, "Not in a room."
	end
	
	-- Announce departure
	if RoomSystem.RoomChannel then
		RoomSystem.RoomChannel:Send("LEAVE", LocalPlayer.DisplayName)
		RoomSystem.RoomChannel:Close()
	end
	
	local oldRoom = RoomSystem.CurrentRoom
	RoomSystem.CurrentRoom = nil
	RoomSystem.RoomChannel = nil
	RoomSystem.IsHost = false
	
	return true, "Left room: " .. oldRoom
end

-- Send a message to the room
function RoomSystem.Send(message)
	if not RoomSystem.CurrentRoom then
		return false, "Not in a room."
	end
	
	if not message or message == "" then
		return false, "Message cannot be empty."
	end
	
	RoomSystem.RoomChannel:Send("MESSAGE", message)
	return true, "Message sent"
end

-- Event callbacks (can be overridden)
RoomSystem.OnPlayerJoined = nil
RoomSystem.OnPlayerLeft = nil
RoomSystem.OnMessage = nil

