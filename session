--========================================================
--  RENTRY MULTIPLAYER LOBBY MODULE (with CSRF & proper form‑data)
--========================================================
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

local module = {}

local session = {
    pageId = nil,
    editCode = nil,
    accessCode = nil,
    messages = {},
    listeners = {}
}

-- helper: URL‑encode a table as form data
local function formEncode(tbl)
    local parts = {}
    for k,v in pairs(tbl) do
        table.insert(parts,
            HttpService:UrlEncode(k) .. "=" .. HttpService:UrlEncode(tostring(v))
        )
    end
    return table.concat(parts, "&")
end

-- helper: perform a GET to rentry root to retrieve CSRF token/cookie
local function getCsrf()
    local ok, res = pcall(function()
        return request({
            Url = "https://rentry.co/",
            Method = "GET",
            Headers = { ["Accept"] = "*/*" }
        })
    end)
    if not ok or not res or res.StatusCode ~= 200 then
        return nil
    end
    local cookies = res.Headers["set-cookie"] or res.Headers["Set-Cookie"]
    if not cookies then return nil end
    local token = cookies:match("csrftoken=([^;]+)")
    if not token then return nil end
    return token, cookies
end

--========================================================
-- RAW PAGE PARSER (metadata + --- + JSON)
--========================================================
local function parseRaw(rawText)
    local i = rawText:find("\n---")
    if not i then return nil end
    local json = rawText:sub(i + 4)
    return decode(json)
end

--========================================================
-- READ RAW JSON FROM PAGE
--========================================================
local function readRaw()
    if not session.pageId then return nil end

    local url = "https://rentry.co/" .. session.pageId .. "/raw"

    local ok, res = pcall(function()
        return request({
            Url = url,
            Method = "GET",
            Headers = {
                ["Accept"] = "*/*",
                ["rentry-auth"] = session.accessCode or ""
            }
        })
    end)

    if not ok or not res or res.StatusCode ~= 200 then
        return nil
    end

    return parseRaw(res.Body)
end

--========================================================
-- WRITE RAW JSON TO PAGE
--========================================================
local function writeRaw(dataTable)
    local text =
        "SECRET_RAW_ACCESS_CODE = " .. session.accessCode .. "\n" ..
        "---\n" ..
        encode(dataTable)

    local ok, res = pcall(function()
        return request({
            Url = "https://rentry.co/api/edit/" .. session.pageId,
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json",
                ["Accept"] = "application/json"
            },
            Body = encode({
                edit_code = session.editCode,
                text = text
            })
        })
    end)

    return ok and res and res.StatusCode == 200
end


--========================================================
-- PUBLIC: CREATE LOBBY
--========================================================
function module.CreateLobby()
    -- 1: get csrf token + cookies
    local csrf, cookie = getCsrf()
    if not csrf then
        warn("[CreateLobby] Failed to get CSRF token")
        return nil, nil, nil
    end

    -- 2: POST to /api/new using form‑encoded body
    local body = formEncode({
        csrfmiddlewaretoken = csrf,
        text = "initializing..."
    })

    local ok, res = pcall(function()
        return request({
            Url = "https://rentry.co/api/new",
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/x-www-form-urlencoded",
                ["Cookie"] = cookie,
                ["Referer"] = "https://rentry.co/",
                ["Accept"] = "application/json"
            },
            Body = body
        })
    end)

    if not ok or not res or res.StatusCode ~= 200 then
        warn("[CreateLobby] /api/new request failed", res and res.StatusCode or res)
        return nil, nil, nil
    end

    local data
    local ok2, err = pcall(function()
        data = HttpService:JSONDecode(res.Body)
    end)
    if not ok2 or not data or not data.url or not data.edit_code then
        warn("[CreateLobby] Invalid JSON or missing url/edit_code", res.Body)
        return nil, nil, nil
    end

    local pageId = data.url:sub(2)  -- remove leading "/"
    local editCode = data.edit_code
    local accessCode = tostring(math.random(100000, 999999))

    session.pageId = pageId
    session.editCode = editCode
    session.accessCode = accessCode
    session.messages = {}

    -- 3: Write initial JSON (players/messages) with metadata
    local initial = {
        messages = {},
        players = {},
        created = os.time()
    }

    local content = "SECRET_RAW_ACCESS_CODE = " .. accessCode .. "\n" ..
                    "---\n" .. HttpService:JSONEncode(initial)

    -- Need to re‑get CSRF token (fresh session)
    local csrf2, cookie2 = getCsrf()
    if not csrf2 then
        warn("[CreateLobby] Failed to get CSRF token for edit")
        return pageId, editCode, accessCode  -- page exists, but write may fail
    end

    local body2 = formEncode({
        csrfmiddlewaretoken = csrf2,
        edit_code = editCode,
        text = content
    })

    local ok3, res2 = pcall(function()
        return request({
            Url = "https://rentry.co/api/edit/" .. pageId,
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/x-www-form-urlencoded",
                ["Cookie"] = cookie2,
                ["Referer"] = "https://rentry.co/" .. pageId,
                ["Accept"] = "application/json"
            },
            Body = body2
        })
    end)

    if not ok3 or not res2 or res2.StatusCode ~= 200 then
        warn("[CreateLobby] Failed to write initial page data", res2 and res2.StatusCode or res2)
        return pageId, editCode, accessCode
    end

    return pageId, editCode, accessCode
end

--========================================================
-- PUBLIC: JOIN LOBBY
--========================================================
function module.JoinLobby(pageId, editCode, accessCode)
    session.pageId = pageId
    session.editCode = editCode
    session.accessCode = accessCode

    local data = readRaw()
    if not data then return false end

    session.messages = data.messages or {}

    -- Update players list
    data.players = data.players or {}
    local myName = Players.LocalPlayer.Name
    if not table.find(data.players, myName) then
        table.insert(data.players, myName)
        writeRaw(data)
    end

    return true
end

--========================================================
-- PUBLIC: LEAVE LOBBY
--========================================================
function module.LeaveLobby()
    session.pageId = nil
    session.editCode = nil
    session.accessCode = nil
    session.messages = {}
    session.listeners = {}
end

--========================================================
-- PUBLIC: SEND MESSAGE
--========================================================
function module.SendMessage(text)
    if not session.pageId then return false end
    local data = readRaw()
    if not data then return false end

    local msg = {
        author = Players.LocalPlayer.Name,
        text = text,
        time = os.time()
    }

    data.messages = data.messages or {}
    table.insert(data.messages, msg)

    session.messages = data.messages
    writeRaw(data)

    return true
end

--========================================================
-- PUBLIC: LISTEN TO MESSAGES
-- includeSelf = true/false
-- callback(messageTable)
--========================================================
function module.ListenToMessages(includeSelf, callback)
    table.insert(session.listeners, {
        includeSelf = includeSelf,
        callback = callback,
        lastCount = #session.messages
    })
end

--========================================================
-- PUBLIC: LIST PLAYERS IN LOBBY
--========================================================
function module.ListPlayersInLobby()
    local data = readRaw()
    if not data or not data.players then return {} end
    return data.players
end

--========================================================
-- BACKGROUND LISTENER LOOP
--========================================================
task.spawn(function()
    while true do
        if session.pageId then
            local data = readRaw()
            if data then
                local new = data.messages or {}

                -- Check all listeners
                for _, listener in ipairs(session.listeners) do
                    if #new > listener.lastCount then
                        for i = listener.lastCount + 1, #new do
                            local msg = new[i]
                            if listener.includeSelf or msg.author ~= Players.LocalPlayer.Name then
                                listener.callback(msg)
                            end
                        end
                    end
                    listener.lastCount = #new
                end

                session.messages = new
            end
        end
        task.wait(1)
    end
end)

return module
