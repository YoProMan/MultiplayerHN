local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local module = {}

local JSONBIN_API_KEY = "$2a$10$Tpvo6h8xS1iR4LPV385IFOQyndfLi88O0sOIV/Q9mc.2wsd3wpePO"
local JSONBIN_BASE = "https://api.jsonbin.io/v3/b"

local session = {
    binId = nil,
    messages = {},
    listeners = {}
}

local function encode(t) return HttpService:JSONEncode(t) end
local function decode(s)
    local ok, data = pcall(function() return HttpService:JSONDecode(s) end)
    return ok and data or nil
end

local function writeBin(data)
    if not session.binId then return false end
    local ok, res = pcall(function()
        return request({
            Url = JSONBIN_BASE .. "/" .. session.binId,
            Method = "PUT",
            Headers = {
                ["Content-Type"] = "application/json",
                ["X-Master-Key"] = JSONBIN_API_KEY
            },
            Body = encode(data)
        })
    end)
    return ok and res and res.StatusCode >= 200 and res.StatusCode < 300
end

local function readBin()
    if not session.binId then return nil end
    local ok, res = pcall(function()
        return request({
            Url = JSONBIN_BASE .. "/" .. session.binId .. "/latest",
            Method = "GET",
            Headers = {
                ["X-Master-Key"] = JSONBIN_API_KEY
            }
        })
    end)
    if not ok or not res or res.StatusCode ~= 200 then return nil end
    local decoded = decode(res.Body)
    return decoded and decoded.record or nil
end

function module.CreateLobby()
    local initialData = {
        messages = {},
        players = { LocalPlayer.Name }, -- add creator
        created = os.time()
    }

    local ok, res = pcall(function()
        return request({
            Url = JSONBIN_BASE,
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json",
                ["X-Master-Key"] = JSONBIN_API_KEY,
                ["X-Bin-Private"] = "false"
            },
            Body = encode(initialData)
        })
    end)

    if not ok or not res or res.StatusCode < 200 or res.StatusCode >= 300 then
        warn("Failed to create lobby")
        return nil
    end

    local body = decode(res.Body)
    if not body or not body.metadata or not body.metadata.id then
        warn("Invalid response from JSONBIN")
        return nil
    end

    session.binId = body.metadata.id
    session.messages = initialData.messages
    return session.binId
end

function module.JoinLobby(binId)
    session.binId = binId
    local data = readBin()
    if not data then return false end

    data.players = data.players or {}
    local name = LocalPlayer.Name
    if not table.find(data.players, name) then
        table.insert(data.players, name)
        writeBin(data)
    end

    session.messages = data.messages or {}
    return true
end

function module.LeaveLobby()
    if not session.binId then return end
    local data = readBin()
    if data and data.players then
        local name = LocalPlayer.Name
        for i = #data.players, 1, -1 do
            if data.players[i] == name then
                table.remove(data.players, i)
            end
        end
        writeBin(data)
    end
    session.binId = nil
    session.messages = {}
    session.listeners = {}
end

function module.SendMessage(text)
    if not session.binId then return false end
    local data = readBin()
    if not data then return false end

    data.messages = data.messages or {}
    local msg = {
        author = LocalPlayer.Name,
        text = text,
        time = os.time()
    }
    table.insert(data.messages, msg)
    session.messages = data.messages
    return writeBin(data)
end

function module.ListenToMessages(includeSelf, callback)
    table.insert(session.listeners, {
        includeSelf = includeSelf,
        callback = callback,
        lastCount = #session.messages
    })
end

function module.ListPlayersInLobby()
    local data = readBin()
    if not data or not data.players then return {} end
    return data.players
end

task.spawn(function()
    while true do
        if session.binId then
            local data = readBin()
            if data then
                local msgs = data.messages or {}
                for _, listener in ipairs(session.listeners) do
                    if #msgs > listener.lastCount then
                        for i = listener.lastCount + 1, #msgs do
                            local msg = msgs[i]
                            if listener.includeSelf or msg.author ~= LocalPlayer.Name then
                                listener.callback(msg)
                            end
                        end
                    end
                    listener.lastCount = #msgs
                end
                session.messages = msgs
            end
        end
        task.wait(1)
    end
end)

Players.PlayerRemoving:Connect(function(player)
    if player==LocalPlayer then
        module.LeaveLobby()
    end
end)

return module
