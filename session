--========================================================
--  RENTRY MULTIPLAYER LOBBY MODULE (API-READY VERSION)
--========================================================
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

local module = {}

--========================================================
-- SESSION STATE
--========================================================
local session = {
    pageId = nil,
    editCode = nil,
    accessCode = nil,
    messages = {},
    listeners = {}
}

local function encode(t)  return HttpService:JSONEncode(t) end
local function decode(s)
    local ok, data = pcall(function() return HttpService:JSONDecode(s) end)
    return ok and data or nil
end

--========================================================
-- RAW PAGE PARSER (metadata + --- + JSON)
--========================================================
local function parseRaw(rawText)
    local i = rawText:find("\n---")
    if not i then return nil end
    local json = rawText:sub(i + 4)
    return decode(json)
end

--========================================================
-- READ RAW JSON FROM PAGE
--========================================================
local function readRaw()
    if not session.pageId then return nil end

    local url = "https://rentry.co/" .. session.pageId .. "/raw"

    local ok, res = pcall(function()
        return request({
            Url = url,
            Method = "GET",
            Headers = {
                ["Accept"] = "*/*",
                ["rentry-auth"] = session.accessCode or ""
            }
        })
    end)

    if not ok or not res or res.StatusCode ~= 200 then
        return nil
    end

    return parseRaw(res.Body)
end

--========================================================
-- WRITE RAW JSON TO PAGE
--========================================================
local function writeRaw(dataTable)
    local text =
        "SECRET_RAW_ACCESS_CODE = " .. session.accessCode .. "\n" ..
        "---\n" ..
        encode(dataTable)

    local ok, res = pcall(function()
        return request({
            Url = "https://rentry.co/api/edit/" .. session.pageId,
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json",
                ["Accept"] = "application/json"
            },
            Body = encode({
                edit_code = session.editCode,
                text = text
            })
        })
    end)

    return ok and res and res.StatusCode == 200
end

--========================================================
-- PUBLIC: CREATE LOBBY
--========================================================
-- Helper: check whether rentry URL exists (returns true if page exists / taken)
local function pageExists(id)
    if not id then return false end
    local ok, res = pcall(function()
        return request({
            Url = "https://rentry.co/" .. tostring(id),
            Method = "GET",
            Headers = { ["Accept"] = "*/*" }
        })
    end)
    if not ok or not res then
        -- If the request fails (network), assume not taken (so caller can try) 
        -- or you can choose to return true to be conservative.
        return false
    end
    -- If status == 200 then page exists (taken). 404 (or redirect to root) likely means free.
    return res.StatusCode == 200
end

-- Helper: generate a random lowercase alpha string of given length
local function makeRandomId(minLen, maxLen)
    minLen = minLen or 10
    maxLen = maxLen or 16
    local length = math.random(minLen, maxLen)
    local s = ""
    for i = 1, length do
        s = s .. string.char(math.random(97, 122)) -- a-z
    end
    return s
end

-- Robust CreateLobby replacement (returns pageId, editCode, accessCode)
function module.CreateLobby()
    local maxAttempts = 8
    local newId = nil

    for attempt = 1, maxAttempts do
        local candidate = makeRandomId(12, 14) -- 12-14 letters, change if you want
        if not pageExists(candidate) then
            newId = candidate
            break
        end
        -- small wait between tries (optional)
        task.wait(0.05)
    end

    if not newId then
        -- fallback to a GUID-like one (still alpha + dashes removed)
        newId = tostring(HttpService:GenerateGUID(false)):gsub("%-",""):sub(1,14)
    end

    -- generate edit and access codes (kept numeric for human copy/paste)
    local edit = tostring(math.random(100000, 999999))
    local access = tostring(math.random(100000, 999999))

    -- set session state (module's session table assumed)
    session.pageId = newId
    session.editCode = edit
    session.accessCode = access
    session.messages = {}

    -- create initial payload and write using your existing writeRaw() function
    local initial = {
        messages = {},
        players = {},
        created = os.time()
    }

    -- writeRaw should already exist in your module and will write metadata + JSON correctly
    local ok = writeRaw(initial)
    if not ok then
        warn("CreateLobby: failed to write initial page content for id:", newId)
        -- you can choose to return nils here
    end

    return newId, edit, access
end

--========================================================
-- PUBLIC: JOIN LOBBY
--========================================================
function module.JoinLobby(pageId, editCode, accessCode)
    session.pageId = pageId
    session.editCode = editCode
    session.accessCode = accessCode

    local data = readRaw()
    if not data then return false end

    session.messages = data.messages or {}

    -- Update players list
    data.players = data.players or {}
    local myName = Players.LocalPlayer.Name
    if not table.find(data.players, myName) then
        table.insert(data.players, myName)
        writeRaw(data)
    end

    return true
end

--========================================================
-- PUBLIC: LEAVE LOBBY
--========================================================
function module.LeaveLobby()
    session.pageId = nil
    session.editCode = nil
    session.accessCode = nil
    session.messages = {}
    session.listeners = {}
end

--========================================================
-- PUBLIC: SEND MESSAGE
--========================================================
function module.SendMessage(text)
    if not session.pageId then return false end
    local data = readRaw()
    if not data then return false end

    local msg = {
        author = Players.LocalPlayer.Name,
        text = text,
        time = os.time()
    }

    data.messages = data.messages or {}
    table.insert(data.messages, msg)

    session.messages = data.messages
    writeRaw(data)

    return true
end

--========================================================
-- PUBLIC: LISTEN TO MESSAGES
-- includeSelf = true/false
-- callback(messageTable)
--========================================================
function module.ListenToMessages(includeSelf, callback)
    table.insert(session.listeners, {
        includeSelf = includeSelf,
        callback = callback,
        lastCount = #session.messages
    })
end

--========================================================
-- PUBLIC: LIST PLAYERS IN LOBBY
--========================================================
function module.ListPlayersInLobby()
    local data = readRaw()
    if not data or not data.players then return {} end
    return data.players
end

--========================================================
-- BACKGROUND LISTENER LOOP
--========================================================
task.spawn(function()
    while true do
        if session.pageId then
            local data = readRaw()
            if data then
                local new = data.messages or {}

                -- Check all listeners
                for _, listener in ipairs(session.listeners) do
                    if #new > listener.lastCount then
                        for i = listener.lastCount + 1, #new do
                            local msg = new[i]
                            if listener.includeSelf or msg.author ~= Players.LocalPlayer.Name then
                                listener.callback(msg)
                            end
                        end
                    end
                    listener.lastCount = #new
                end

                session.messages = new
            end
        end
        task.wait(1)
    end
end)

return module
