-- RentryLobby.lua
-- Uses Rentry.co API to store lobbies as pastes — with players + messages JSON.

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

local module = {}

local session = {
    pageId = nil,
    editCode = nil,
    accessCode = nil,
    messages = {},
    listeners = {}
}

-- Helper: URL‑encode form data
local function formEncode(tbl)
    local parts = {}
    for k, v in pairs(tbl) do
        parts[#parts + 1] = HttpService:UrlEncode(k) .. "=" .. HttpService:UrlEncode(tostring(v))
    end
    return table.concat(parts, "&")
end

-- Helper: send GET or POST, returns response or nil
local function doRequest(req)
    local ok, res = pcall(function() return request(req) end)
    if not ok or not res then return nil end
    return res
end

-- Step 1: GET root to retrieve CSRF cookie
local function getCsrf()
    local res = doRequest({ Url = "https://rentry.co/", Method = "GET", Headers = { ["Accept"] = "*/*" } })
    if not res or res.StatusCode ~= 200 then
        return nil
    end
    local cookies = res.Headers["set-cookie"] or res.Headers["Set-Cookie"]
    if not cookies then return nil end
    local token = cookies:match("csrftoken=([^;]+)")
    return token, cookies
end

-- Step 2: parse JSON‑wrapped data from raw page
local function parseRaw(raw)
    local i = raw:find("\n---")
    if not i then return nil end
    local jsonPart = raw:sub(i + 4)
    local ok, data = pcall(function() return HttpService:JSONDecode(jsonPart) end)
    if ok then return data end
    return nil
end

-- ==========================
-- PUBLIC API
-- ==========================

-- Create a new lobby → returns pageId, editCode, accessCode or nil if failed
function module.CreateLobby()
    local csrf, cookie = getCsrf()
    if not csrf then
        warn("[RentryLobby] Failed to fetch CSRF token")
        return nil
    end

    -- POST to /api/new
    local body = formEncode({
        csrfmiddlewaretoken = csrf,
        text = "initial\n"  -- placeholder content
    })

    local res = doRequest({
        Url = "https://rentry.co/api/new",
        Method = "POST",
        Headers = {
            ["Content-Type"] = "application/x-www-form-urlencoded",
            ["Cookie"] = cookie,
            ["Referer"] = "https://rentry.co/",
            ["Accept"] = "application/json"
        },
        Body = body
    })

    if not res or res.StatusCode ~= 200 then
        warn("[RentryLobby] /api/new failed:", res and res.StatusCode)
        return nil
    end

    local ok, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
    if not ok or not data or not data.url or not data.edit_code then
        warn("[RentryLobby] Invalid /new response:", res.Body)
        return nil
    end

    local pageId = data.url:sub(2)  -- strip leading "/"
    local edit = data.edit_code
    local access = tostring(math.random(100000, 999999))

    session.pageId = pageId
    session.editCode = edit
    session.accessCode = access
    session.messages = {}

    -- Now write initial JSON to page
    local init = { players = {}, messages = {}, created = os.time() }
    local content = "SECRET_RAW_ACCESS_CODE = " .. access .. "\n---\n" .. HttpService:JSONEncode(init)

    -- Must re‑get CSRF (fresh session)
    local csrf2, cookie2 = getCsrf()
    if not csrf2 then
        warn("[RentryLobby] Failed to get CSRF for edit")
        return pageId, edit, access
    end

    local body2 = formEncode({
        csrfmiddlewaretoken = csrf2,
        edit_code = edit,
        text = content
    })

    local res2 = doRequest({
        Url = "https://rentry.co/api/edit/" .. pageId,
        Method = "POST",
        Headers = {
            ["Content-Type"] = "application/x-www-form-urlencoded",
            ["Cookie"] = cookie2,
            ["Referer"] = "https://rentry.co/" .. pageId,
            ["Accept"] = "application/json"
        },
        Body = body2
    })

    if not res2 or res2.StatusCode ~= 200 then
        warn("[RentryLobby] Failed to write initial page data (edit)", res2 and res2.StatusCode or "")
        return pageId, edit, access
    end

    return pageId, edit, access
end

-- Join an existing lobby (pageId, editCode, accessCode) → returns true/false
function module.JoinLobby(pageId, editCode, accessCode)
    session.pageId = pageId
    session.editCode = editCode
    session.accessCode = accessCode

    local rawRes = doRequest({
        Url = "https://rentry.co/" .. pageId .. "/raw",
        Method = "GET",
        Headers = {
            ["Accept"] = "*/*",
            ["rentry‑auth"] = accessCode
        }
    })
    if not rawRes or rawRes.StatusCode ~= 200 then
        warn("[RentryLobby] JoinLobby: raw fetch failed")
        return false
    end

    local data = parseRaw(rawRes.Body)
    if not data then
        warn("[RentryLobby] JoinLobby: parse failed")
        return false
    end

    data.players = data.players or {}
    local name = Players.LocalPlayer.Name
    if not table.find(data.players, name) then
        table.insert(data.players, name)
        -- write back
        -- (reuse the write logic)
        session.messages = data.messages or {}
        return module.SendMessage("") and true  -- cheap hack to write the updated players list
    end

    session.messages = data.messages or {}
    return true
end

-- Send a message
function module.SendMessage(text)
    if not session.pageId then return false end

    local rawRes = doRequest({
        Url = "https://rentry.co/" .. session.pageId .. "/raw",
        Method = "GET",
        Headers = {
            ["Accept"] = "*/*",
            ["rentry‑auth"] = session.accessCode
        }
    })
    if not rawRes or rawRes.StatusCode ~= 200 then
        warn("[RentryLobby] SendMessage: raw fetch failed")
        return false
    end

    local data = parseRaw(rawRes.Body)
    if not data then
        warn("[RentryLobby] SendMessage: parse failed")
        return false
    end

    data.messages = data.messages or {}
    data.players = data.players or {}

    local entry = {
        author = Players.LocalPlayer.Name,
        text = text,
        time = os.time()
    }
    table.insert(data.messages, entry)

    -- re‑build content
    local content = "SECRET_RAW_ACCESS_CODE = " .. session.accessCode .. "\n---\n" .. HttpService:JSONEncode(data)

    -- get CSRF again
    local csrf2, cookie2 = getCsrf()
    if not csrf2 then
        warn("[RentryLobby] SendMessage: could not get CSRF for edit")
        return false
    end

    local body2 = formEncode({ csrfmiddlewaretoken = csrf2, edit_code = session.editCode, text = content })

    local res2 = doRequest({
        Url = "https://rentry.co/api/edit/" .. session.pageId,
        Method = "POST",
        Headers = {
            ["Content-Type"] = "application/x-www-form-urlencoded",
            ["Cookie"] = cookie2,
            ["Referer"] = "https://rentry.co/" .. session.pageId,
            ["Accept"] = "application/json"
        },
        Body = body2
    })

    if not res2 or res2.StatusCode ~= 200 then
        warn("[RentryLobby] SendMessage: failed to edit page", res2 and res2.StatusCode or "")
        return false
    end

    session.messages = data.messages
    return true
end

-- Get current players
function module.ListPlayersInLobby()
    if not session.pageId then return {} end
    local rawRes = doRequest({
        Url = "https://rentry.co/" .. session.pageId .. "/raw",
        Method = "GET",
        Headers = { ["Accept"] = "*/*", ["rentry‑auth"] = session.accessCode }
    })
    if not rawRes or rawRes.StatusCode ~= 200 then return {} end
    local data = parseRaw(rawRes.Body)
    if not data then return {} end
    return data.players or {}
end

-- Listen to messages (includeSelf: bool, callback(msgTable))
function module.ListenToMessages(includeSelf, callback)
    table.insert(session.listeners, { includeSelf = includeSelf, callback = callback, last = #session.messages })
end

-- Background listener
task.spawn(function()
    while true do
        if session.pageId then
            local rawRes = doRequest({
                Url = "https://rentry.co/" .. session.pageId .. "/raw",
                Method = "GET",
                Headers = { ["Accept"] = "*/*", ["rentry‑auth"] = session.accessCode }
            })
            if rawRes and rawRes.StatusCode == 200 then
                local data = parseRaw(rawRes.Body)
                if data and data.messages then
                    for _, lst in ipairs(session.listeners) do
                        for i = (lst.last + 1), #data.messages do
                            local msg = data.messages[i]
                            if lst.includeSelf or msg.author ~= Players.LocalPlayer.Name then
                                lst.callback(msg)
                            end
                        end
                        lst.last = #data.messages
                    end
                    session.messages = data.messages
                end
            end
        end
        task.wait(1)
    end
end)

return module
